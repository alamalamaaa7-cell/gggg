# ==== Salin file ini jadi .env dan isi manual (JANGAN commit .env asli ke git) ====

# Diisi otomatis oleh Railway kalau pakai plugin PostgreSQL (Variable Reference).
# Untuk lokal, isi manual: postgres://user:pass@localhost:5432/upclaselam
DATABASE_URL=

# Dari Google Cloud Console (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://upclaselam.vercel.app/api/auth/google/callback

# String acak panjang untuk menandatangani JWT (boleh generate: openssl rand -hex 32)
JWT_SECRET= 5a23af7e49ea20a979d6609147e5f51e

# Email ini otomatis jadi role admin (bisa buka Panel Admin)
ADMIN_EMAIL=lamzy103@gmail.com

# URL frontend (Vercel) - dipakai untuk CORS & redirect setelah login Google
FRONTEND_URL=http://localhost:3000

NODE_ENV=development
PORT=8080

# Endpoint API upscale foto/video pihak ketiga (boleh diganti tanpa redeploy frontend)
UPSCALE_PHOTO_API=https://api.ikyyxd.my.id/tools/upscale?url=
UPSCALE_VIDEO_API=https://api.ikyyxd.my.id/tools/hdvidd?videourl=

# Host sementara untuk upload file jadi URL publik (dipakai backend, bukan browser)
TMP_HOST_UPLOAD=https://tmpfiles.org/api/v1/upload
